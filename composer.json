{
    "name": "yurievyuri/address-parser",
    "description": "Parses free-form postal address strings into structured components: line1, line2, city, postcode, country.",
    "type": "library",
    "keywords": [
        "address",
        "postcode",
        "parser",
        "postal",
        "geocoding"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Yura Yurev",
            "email": "yurievyuri@live.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "phpunit/phpunit": "^11.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Address\\Parser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Address\\Parser\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "suggest": {
        "anthropic-ai/sdk": "Needed only by the built-in Claude service.",
        "symfony/yaml": "Lets you keep the service pipeline in a YAML file.",
        "guzzlehttp/guzzle": "Any PSR-18 client will do; discovery finds the one your project already has."
    }
}
